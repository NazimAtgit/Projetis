rules_version = '2';
// Règles de sécurité Firestore pour Atelier Projets ESST.
// Rôles : administrateur (adresse ci-dessous, voit tout), encadrants (collection supervisors,
// ne voient que leurs projets), étudiants (collection users, voient les projets de leur encadrant).
// Chaque projet, étudiant, tâche et événement porte un champ "owner" = e-mail de son encadrant.
service cloud.firestore {
  match /databases/{db}/documents {

    function email() { return request.auth.token.email.lower(); }
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function isAdmin() { return signedIn() && email() in ['nazim.ouadahi@esst-sup.com']; }
    function isSup() { return signedIn() && exists(/databases/$(db)/documents/supervisors/$(email())); }
    function isStudent() { return signedIn() && exists(/databases/$(db)/documents/users/$(email())); }
    function me() { return get(/databases/$(db)/documents/users/$(email())).data; }
    function canRead(o) { return isAdmin() || (isSup() && o == email()) || (isStudent() && o == me().owner); }
    function manages(o) { return isAdmin() || (isSup() && o == email()); }
    // getAfter : état après l'écriture, pour accepter un projet et ses tâches créés dans le même lot.
    function projOwner(pid) { return getAfter(/databases/$(db)/documents/projects/$(pid)).data.owner; }
    function sameOwner(d) { return isAdmin() || d.projectId == '' || projOwner(d.projectId) == d.owner; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // Barème des points : lu par tous les inscrits, modifié par l'administrateur.
    match /settings/{id} {
      allow read: if isAdmin() || isSup() || isStudent();
      allow write: if isAdmin();
    }

    // Encadrants : gérés par l'administrateur ; chacun lit sa propre fiche.
    match /supervisors/{sid} {
      allow read: if isAdmin() || (signedIn() && sid == email());
      allow write: if isAdmin();
    }

    match /projects/{id} {
      allow read: if canRead(resource.data.owner);
      allow create: if manages(request.resource.data.owner);
      allow update: if manages(resource.data.owner) && manages(request.resource.data.owner);
      allow delete: if manages(resource.data.owner);
    }

    // Étudiants : l'encadrant gère les siens ; l'étudiant ne fait avancer que son tutoriel.
    match /users/{uid} {
      allow read: if canRead(resource.data.owner) || (signedIn() && uid == email());
      allow create: if manages(request.resource.data.owner) && sameOwner(request.resource.data);
      allow update: if (manages(resource.data.owner) && manages(request.resource.data.owner) && sameOwner(request.resource.data))
        || (isStudent() && uid == email() && changed().hasOnly(['tutorial']));
      allow delete: if manages(resource.data.owner);
    }

    // Tâches : l'étudiant ne touche qu'à ses tâches (ou prend une tâche libre de son projet),
    // ne peut jamais les passer en « fait » ni s'attribuer des points.
    match /tasks/{id} {
      allow read: if canRead(resource.data.owner);
      allow delete: if manages(resource.data.owner);
      allow create: if (manages(request.resource.data.owner) && sameOwner(request.resource.data))
        || (isStudent()
            && request.resource.data.kind == 'diagnostic'
            && request.resource.data.assignee == email()
            && request.resource.data.status == 'en_cours'
            && request.resource.data.size == 'S'
            && request.resource.data.projectId == me().projectId
            && request.resource.data.owner == me().owner
            && !('pointsAwarded' in request.resource.data));
      allow update: if (manages(resource.data.owner) && manages(request.resource.data.owner) && sameOwner(request.resource.data))
        || (isStudent()
            && resource.data.projectId == me().projectId
            && (resource.data.assignee == email() || resource.data.assignee == null)
            && request.resource.data.assignee == email()
            && resource.data.status != 'fait'
            && request.resource.data.status in ['en_cours', 'a_valider', 'bloque']
            && changed().hasOnly(['status', 'assignee', 'startedAt', 'submittedAt', 'proof', 'problem', 'feedback']));
    }

    // Historique : chacun ajoute ses propres événements dans le périmètre de son encadrant.
    match /events/{id} {
      allow read: if canRead(resource.data.owner);
      allow create: if request.resource.data.actor == email()
        && (manages(request.resource.data.owner) || (isStudent() && request.resource.data.owner == me().owner));
      allow update, delete: if manages(resource.data.owner);
    }
  }
}
